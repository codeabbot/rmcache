package com.codeabbot.rmcache.index;

import com.codeabbot.rmcache.memory.NativeMemory;
import com.codeabbot.rmcache.util.Prefetch;
import java.lang.foreign.MemorySegment;
import java.lang.foreign.ValueLayout;
import java.util.concurrent.ConcurrentLinkedQueue;
import java.util.concurrent.locks.StampedLock;

/**
 * High-performance hash table using Robin Hood hashing with packed slots.
 * Ported from Kotlin implementation relative to V11 architecture (Segmented +
 * Raw Memory).
 *
 * @author Rabindra Meher
 */
public class OffHeapHashTable implements AutoCloseable {

    private final EntryPool entryPool;
    private final int numStripes;
    private final boolean enablePrefetch;

    private final int stripeShift;
    private final int stripeMask;

    private final long[] tableAddrs;
    private final int[] tableMasks;
    private final int[] tableCapacities;
    private final int[] tableCounts;
    private final StampedLock[] tableLocks;
    private final MemorySegment[] tableSegments;

    // Async cleanup queue for retired tables (drained by LRU executor)
    private final ConcurrentLinkedQueue<MemorySegment> cleanupQueue = new ConcurrentLinkedQueue<>();

    private static final int SLOT_SIZE = 16; // 8 bytes packed hash+len, 8 bytes slot

    public OffHeapHashTable(EntryPool entryPool, long memoryBytes, int numStripes, boolean enablePrefetch) {
        this.entryPool = entryPool;
        // Adjust numStripes to power of 2
        int powerOf2 = 1;
        int shift = 0;
        int targetStripes = (numStripes < 1) ? 16384 : numStripes;

        while (powerOf2 < targetStripes) {
            powerOf2 <<= 1;
            shift++;
        }
        this.numStripes = powerOf2;
        this.stripeMask = powerOf2 - 1;
        this.stripeShift = 32 - shift;
        this.enablePrefetch = enablePrefetch;

        this.tableAddrs = new long[powerOf2];
        this.tableMasks = new int[powerOf2];
        this.tableCapacities = new int[powerOf2];
        this.tableCounts = new int[powerOf2];
        this.tableLocks = new StampedLock[powerOf2];
        this.tableSegments = new MemorySegment[powerOf2];

        for (int i = 0; i < powerOf2; i++) {
            this.tableLocks[i] = new StampedLock();
            int cap = 256; // Higher initial capacity
            MemorySegment seg = NativeMemory.calloc(cap, SLOT_SIZE);
            this.tableSegments[i] = seg;
            this.tableAddrs[i] = seg.address();
            this.tableMasks[i] = cap - 1;
            this.tableCapacities[i] = cap;
        }
    }

    @Override
    public void close() {
        // Free active tables
        for (MemorySegment seg : tableSegments) {
            if (seg != null) {
                NativeMemory.free(seg);
            }
        }
        drainCleanupQueue();
    }

    // Fast-path get
    public int get(int keyHash, byte[] keyBytes) {
        return getWithLen(keyHash, keyBytes, keyBytes.length);
    }

    public int getWithLen(int keyHash, byte[] keyBytes, int keyLen) {
        int sIdx = (keyHash >>> stripeShift) & stripeMask;
        StampedLock lock = tableLocks[sIdx];

        long stamp = lock.tryOptimisticRead();
        // Capture state for optimistic read
        long tableAddr = tableAddrs[sIdx];
        int mask = tableMasks[sIdx];
        int cap = tableCapacities[sIdx];

        int slot = probeWithParams(tableAddr, mask, cap, keyHash, keyBytes, keyLen);

        if (!lock.validate(stamp)) {
            stamp = lock.readLock();
            try {
                // Read fresh state under lock
                return probeWithParams(tableAddrs[sIdx], tableMasks[sIdx], tableCapacities[sIdx], keyHash, keyBytes,
                        keyLen);
            } finally {
                lock.unlockRead(stamp);
            }
        }

        return slot;
    }

    private int probeWithParams(long tableAddr, int mask, int cap, int keyHash, byte[] keyBytes, int keyLen) {
        int index = keyHash & mask;
        int dist = 0;

        long keyLenShifted = (long) keyLen << 32;

        if (enablePrefetch) {
            Prefetch.prefetchNextSlots(tableAddr, index, mask);
        }

        while (true) {
            long entryAddr = tableAddr + ((long) index << 4);
            long slotLong = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, entryAddr + 8);
            int slot = (int) slotLong;

            if (slot == 0)
                return 0;

            if (enablePrefetch) {
                Prefetch.prefetchNextSlots(tableAddr, index, mask, 1);
            }

            long packedHashLen = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, entryAddr);
            int storedHash = (int) packedHashLen;

            if (storedHash == keyHash) {
                // Fast rejection checking upper bits (length)
                if (((packedHashLen ^ keyLenShifted) >>> 32) == 0L) {
                    long offset = entryPool.getOffset(slot);
                    // Use keyEqualsNoLenCheck since length matches
                    if (entryPool.keyEqualsNoLenCheck(offset, keyBytes, keyLen)) {
                        return slot;
                    }
                }
            }

            int ideal = storedHash & mask;
            int probeDist = (index - ideal + cap) & mask;
            if (probeDist < dist)
                return 0;

            index = (index + 1) & mask;
            dist++;
        }
    }

    public int putWithLen(int keyHash, byte[] keyBytes, int keyLen, int slot) {
        int sIdx = (keyHash >>> stripeShift) & stripeMask;
        StampedLock lock = tableLocks[sIdx];
        long stamp = lock.writeLock();
        try {
            if (tableCounts[sIdx] >= (tableCapacities[sIdx] * 0.75)) {
                resize(sIdx);
            }

            long tableAddr = tableAddrs[sIdx];
            int mask = tableMasks[sIdx];
            int cap = tableCapacities[sIdx];

            int index = keyHash & mask;
            int dist = 0;

            long keyLenShifted = (long) keyLen << 32;
            long currPackedHash = (keyHash & 0xFFFFFFFFL) | keyLenShifted;
            long currSlot = slot; // Promoted to long

            while (true) {
                long entryAddr = tableAddr + ((long) index << 4);
                long existingSlot = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, entryAddr + 8);

                if (existingSlot == 0L) {
                    NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, entryAddr, currPackedHash);
                    NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, entryAddr + 8, currSlot);
                    tableCounts[sIdx]++;
                    return 0;
                }

                long existingPackedHash = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, entryAddr);
                int existingHash = (int) existingPackedHash;

                if (existingHash == keyHash) {
                    if (((existingPackedHash ^ keyLenShifted) >>> 32) == 0L) {
                        int realSlot = (int) existingSlot;
                        long offset = entryPool.getOffset(realSlot);
                        if (entryPool.keyEqualsNoLenCheck(offset, keyBytes, keyLen)) {
                            return realSlot; // Duplicate found
                        }
                    }
                }

                int ideal = existingHash & mask;
                int existingDist = (index - ideal + cap) & mask;

                if (existingDist < dist) {
                    // Robin Hood swap
                    long tempPackedHash = existingPackedHash;
                    long tempSlot = existingSlot;

                    NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, entryAddr, currPackedHash);
                    NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, entryAddr + 8, currSlot);

                    currPackedHash = tempPackedHash;
                    currSlot = tempSlot;
                    dist = existingDist;
                }

                index = (index + 1) & mask;
                dist++;
            }
        } finally {
            lock.unlockWrite(stamp);
        }
    }

    public int remove(int keyHash, byte[] keyBytes) {
        int sIdx = (keyHash >>> stripeShift) & stripeMask;
        StampedLock lock = tableLocks[sIdx];
        long stamp = lock.writeLock();
        try {
            long tableAddr = tableAddrs[sIdx];
            int mask = tableMasks[sIdx];
            int cap = tableCapacities[sIdx];

            int index = keyHash & mask;
            int dist = 0;

            while (true) {
                long entryAddr = tableAddr + ((long) index << 4);
                long existingSlotLong = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, entryAddr + 8);

                if (existingSlotLong == 0L)
                    return 0;

                long existingPackedHash = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, entryAddr);
                int existingHash = (int) existingPackedHash;

                if (existingHash == keyHash) {
                    int slot = (int) existingSlotLong;
                    long offset = entryPool.getOffset(slot);
                    // keyBytes logic: ensure we have correct length check either via packed hash or
                    // explicit
                    // Since existingPackedHash contains length, we can check it
                    long keyLenShifted = (long) keyBytes.length << 32;
                    if (((existingPackedHash ^ keyLenShifted) >>> 32) == 0L) {
                        if (entryPool.keyEqualsNoLenCheck(offset, keyBytes, keyBytes.length)) {
                            backwardShift(tableAddr, index, mask, cap);
                            tableCounts[sIdx]--;
                            return slot;
                        }
                    }
                }

                int ideal = existingHash & mask;
                int probeDist = (index - ideal + cap) & mask;
                if (probeDist < dist)
                    return 0;

                index = (index + 1) & mask;
                dist++;
            }
        } finally {
            lock.unlockWrite(stamp);
        }
    }

    private void backwardShift(long tableAddr, int startIdx, int mask, int cap) {
        int idx = startIdx;
        while (true) {
            int nextIdx = (idx + 1) & mask;
            long nextAddr = tableAddr + ((long) nextIdx << 4);
            long nextSlot = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, nextAddr + 8);

            if (nextSlot == 0L) {
                long currAddr = tableAddr + ((long) idx << 4);
                NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, currAddr, 0L);
                NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, currAddr + 8, 0L);
                return;
            }

            long nextHashWithLen = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, nextAddr);
            int nextHash = (int) nextHashWithLen;
            int ideal = nextHash & mask;

            if (ideal == nextIdx) {
                long currAddr = tableAddr + ((long) idx << 4);
                NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, currAddr, 0L);
                NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, currAddr + 8, 0L);
                return;
            }

            long currAddr = tableAddr + ((long) idx << 4);
            NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, currAddr, nextHashWithLen);
            NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, currAddr + 8, nextSlot);

            idx = nextIdx;
        }
    }

    private void resize(int sIdx) {
        int oldCap = tableCapacities[sIdx];
        int newCap = oldCap * 2;
        int newMask = newCap - 1;
        MemorySegment newTable = NativeMemory.calloc(newCap, SLOT_SIZE);
        long oldAddr = tableAddrs[sIdx];
        long newAddr = newTable.address();

        for (int i = 0; i < oldCap; i++) {
            long oldEntryAddr = oldAddr + ((long) i << 4);
            long slot = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, oldEntryAddr + 8);

            if (slot != 0L) {
                long hashPacked = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, oldEntryAddr);
                int hInt = (int) hashPacked;

                int idx = hInt & newMask;
                int dist = 0;
                long currHash = hashPacked;
                long currSlot = slot;

                while (true) {
                    long newEntryAddr = newAddr + ((long) idx << 4);
                    long existingSlot = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, newEntryAddr + 8);

                    if (existingSlot == 0L) {
                        NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, newEntryAddr, currHash);
                        NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, newEntryAddr + 8, currSlot);
                        break;
                    }

                    int existingHashRaw = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_INT, newEntryAddr); // Just lower
                                                                                                          // 32 bits for
                                                                                                          // hash
                    // Optimized: get full long to preserve packing
                    long existingHashPacked = NativeMemory.UNLIMITED.get(ValueLayout.JAVA_LONG, newEntryAddr);
                    int existingHash = (int) existingHashPacked;

                    int ideal = existingHash & newMask;
                    int existingDist = (idx - ideal + newCap) & newMask;

                    if (existingDist < dist) {
                        long tempHash = existingHashPacked;
                        long tempSlot = existingSlot;

                        NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, newEntryAddr, currHash);
                        NativeMemory.UNLIMITED.set(ValueLayout.JAVA_LONG, newEntryAddr + 8, currSlot);

                        currHash = tempHash;
                        currSlot = tempSlot;
                        dist = existingDist;
                    }

                    idx = (idx + 1) & newMask;
                    dist++;
                }
            }
        }

        cleanupQueue.offer(tableSegments[sIdx]);
        tableSegments[sIdx] = newTable;
        tableAddrs[sIdx] = newAddr;
        tableCapacities[sIdx] = newCap;
        tableMasks[sIdx] = newMask;
    }

    public long size() {
        long sum = 0;
        for (int c : tableCounts)
            sum += c;
        return sum;
    }

    public void drainCleanupQueue() {
        MemorySegment seg = cleanupQueue.poll();
        while (seg != null) {
            NativeMemory.free(seg);
            seg = cleanupQueue.poll();
        }
    }

    public void clear() {
        for (int i = 0; i < tableSegments.length; i++) {
            StampedLock lock = tableLocks[i];
            long stamp = lock.writeLock();
            try {
                cleanupQueue.offer(tableSegments[i]);
                int cap = tableCapacities[i]; // Reset to initial? Or keep current capacity?
                // Kotlin implementation resets to current capacity (doesn't shrink, just
                // clears).
                // Actually Kotlin: `val cap = tableCapacities[i]`. So keeps same capacity.
                // Wraps new segment.
                MemorySegment seg = NativeMemory.calloc(cap, SLOT_SIZE);
                tableSegments[i] = seg;
                tableAddrs[i] = seg.address();
                tableCounts[i] = 0;
            } finally {
                lock.unlockWrite(stamp);
            }
        }
    }
}
